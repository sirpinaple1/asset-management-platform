# 本地开发环境配置模板（复制为 .env.development 使用，.env.development 不入库）

# axios baseURL：开发走 Vite 代理（vite.config.ts 将 /api 代理到 VITE_PROXY_TARGET）
VITE_API_BASE_URL=/api

# asset-backend 代理目标（本地后端默认 6006）
VITE_PROXY_TARGET=http://localhost:6006

# auth-center-frontend 登录页（token 失效后跳回）
VITE_AUTH_CENTER_URL=http://localhost:8321

# comm_public_basic 鉴权服务代理目标（钉钉免登接口 /auth-api/** 走此代理）
VITE_AUTH_PROXY_TARGET=http://localhost:6002

# 钉钉企业 corpId（钉钉内打开时 URL ?corpid= 优先生效，此项为兜底）
VITE_DINGTALK_CORP_ID=ding_example_corp_id
